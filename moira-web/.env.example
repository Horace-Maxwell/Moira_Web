MOIRA_WEB_WAIT_SECONDS=120
MOIRA_WEB_POLL_SECONDS=2
DIGITALOCEAN_BUILD_IMAGE=false
DIGITALOCEAN_IMAGE_PLATFORM=linux/amd64
DIGITALOCEAN_WAIT=true
DIGITALOCEAN_VERIFY=true
